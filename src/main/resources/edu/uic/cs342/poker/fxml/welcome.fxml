<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.uic.cs342.poker.controller.WelcomeController"
      prefWidth="1000" prefHeight="650"
      alignment="CENTER" spacing="18" styleClass="screen-root">
    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <VBox alignment="CENTER" spacing="8" prefWidth="450" maxWidth="450"
          minHeight="138" styleClass="table-panel">
        <Label text="THREE CARD POKER" styleClass="menu-title"/>
        <Label text="Multiplayer Casino Edition" styleClass="menu-subtitle"/>
        <VBox.margin>
            <Insets bottom="64"/>
        </VBox.margin>
    </VBox>

    <HBox alignment="CENTER" spacing="64">
        <Button fx:id="startButton" id="startButton" text="Start Game" prefWidth="200" minHeight="44"
                styleClass="gold-button" onAction="#handleStartGame"/>
        <Button id="rulesButton" text="Rules &amp; How to Play" prefWidth="200" minHeight="44"
                styleClass="secondary-button" onAction="#handleShowRules"/>
    </HBox>

    <Button id="quitButton" text="Quit" prefWidth="132" minHeight="44"
            styleClass="secondary-button" onAction="#handleQuitGame"/>

    <Button fx:id="themeButton" id="themeButton" text="Theme: Navy — Change" prefWidth="232" minHeight="44"
            styleClass="secondary-button" onAction="#handleToggleTheme">
        <VBox.margin>
            <Insets top="14"/>
        </VBox.margin>
    </Button>
</VBox>