<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.uic.cs342.poker.controller.ResultsController"
      alignment="TOP_CENTER" spacing="10" styleClass="screen-base-background"
      prefWidth="1000" prefHeight="650">
    <padding><Insets top="12" right="20" bottom="12" left="20" /></padding>
    <Label fx:id="roundNumberLabel" text="Round Summary" styleClass="section-title" />

    <VBox alignment="CENTER" spacing="3">
        <Label text="DEALER'S HAND" styleClass="summary-hand-heading" />
        <HBox fx:id="dealerCardBox" alignment="CENTER" spacing="7"
              prefWidth="250" maxWidth="250" styleClass="summary-tray" />
        <Label fx:id="dealerRankLabel" text="—" styleClass="summary-hand-rank" />
    </VBox>
    <HBox alignment="TOP_CENTER" spacing="16">
        <VBox alignment="CENTER" spacing="6" prefWidth="330" maxWidth="330">
            <Label text="PLAYER 1'S HAND" styleClass="summary-hand-heading" />
            <HBox fx:id="player1CardBox" alignment="CENTER" spacing="8"
                  prefWidth="280" maxWidth="280" styleClass="summary-tray" />
            <Label fx:id="p1RankTopLabel" text="—" styleClass="summary-hand-rank" />
            <VBox alignment="CENTER_LEFT" spacing="7" styleClass="summary-payout-panel">
                <Label fx:id="p1OutcomeLabel" text="—" alignment="CENTER" maxWidth="320"
                       wrapText="true" styleClass="summary-outcome" />
                <Label fx:id="p1RankBoxLabel" text="—" styleClass="summary-copy" />
                <Label text="Wager payout (net profit/loss)" styleClass="summary-panel-heading" />
                <Label fx:id="p1AntePayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p1PlayPayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p1PairPlusPayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p1NetLabel" text="—" styleClass="summary-panel-heading" />
                <Label text="New cumulative winnings" styleClass="summary-panel-heading" />
                <Label fx:id="p1CumulativeLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="10" prefWidth="230" maxWidth="230">
            <VBox alignment="CENTER_LEFT" spacing="5" styleClass="rules-panel">
                <Label text="Hand Payouts" styleClass="summary-hand-heading" />
                <Label text="Pair Plus profit" styleClass="rules-copy" />
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Straight Flush" prefWidth="133" styleClass="summary-reference" />
                    <Label text="40:1" styleClass="summary-reference" />
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Three of a Kind" prefWidth="133" styleClass="summary-reference" />
                    <Label text="30:1" styleClass="summary-reference" />
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Straight" prefWidth="133" styleClass="summary-reference" />
                    <Label text="6:1" styleClass="summary-reference" />
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Flush" prefWidth="133" styleClass="summary-reference" />
                    <Label text="3:1" styleClass="summary-reference" />
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Pair" prefWidth="133" styleClass="summary-reference" />
                    <Label text="1:1" styleClass="summary-reference" />
                </HBox>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="High Card" prefWidth="133" styleClass="summary-reference" />
                    <Label text="None" styleClass="summary-reference" />
                </HBox>
                <Label text="Profit = wager × multiplier. High Card loses the Pair Plus wager. Folding forfeits Pair Plus."
                       wrapText="true" maxWidth="198" styleClass="summary-reference" />
            </VBox>
            <Label text="Bright cards establish rank; dim cards can still break ties. Gold tray = win; muted tray = loss or fold."
                   wrapText="true" textAlignment="CENTER" maxWidth="220" styleClass="summary-reference" />
            <Button id="resultsMenuButton" text="Main Menu" onAction="#handleMainMenu"
                    prefWidth="170" minHeight="36" styleClass="secondary-button" />
            <Button fx:id="playAgainButton" text="Play Again" onAction="#handlePlayAgain"
                    prefWidth="170" minHeight="44" styleClass="gold-button" />
        </VBox>
        <VBox alignment="CENTER" spacing="6" prefWidth="330" maxWidth="330">
            <Label text="PLAYER 2'S HAND" styleClass="summary-hand-heading" />
            <HBox fx:id="player2CardBox" alignment="CENTER" spacing="8"
                  prefWidth="280" maxWidth="280" styleClass="summary-tray" />
            <Label fx:id="p2RankTopLabel" text="—" styleClass="summary-hand-rank" />
            <VBox alignment="CENTER_LEFT" spacing="7" styleClass="summary-payout-panel">
                <Label fx:id="p2OutcomeLabel" text="—" alignment="CENTER" maxWidth="320"
                       wrapText="true" styleClass="summary-outcome" />
                <Label fx:id="p2RankBoxLabel" text="—" styleClass="summary-copy" />
                <Label text="Wager payout (net profit/loss)" styleClass="summary-panel-heading" />
                <Label fx:id="p2AntePayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p2PlayPayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p2PairPlusPayoutLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
                <Label fx:id="p2NetLabel" text="—" styleClass="summary-panel-heading" />
                <Label text="New cumulative winnings" styleClass="summary-panel-heading" />
                <Label fx:id="p2CumulativeLabel" text="—" wrapText="true" maxWidth="304" styleClass="summary-copy" />
            </VBox>
        </VBox>
    </HBox>
</VBox>