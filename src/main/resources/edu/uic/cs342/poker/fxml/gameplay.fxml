<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="screen-base-background" xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="edu.uic.cs342.poker.controller.GameplayController">
    <children>

        <Pane minHeight="650" minWidth="1000" prefHeight="650" prefWidth="1000"
              maxHeight="650" maxWidth="1000" styleClass="table-background"
              StackPane.alignment="TOP_CENTER" />
        <AnchorPane fx:id="tableControls" minHeight="650" minWidth="1000" prefHeight="650" prefWidth="1000"
                    maxHeight="650" maxWidth="1000">
            <children>

                <VBox layoutX="16" layoutY="14" prefWidth="264" spacing="5"
                      alignment="CENTER_LEFT" styleClass="game-info-panel">
                    <Label text="Cumulative winnings" styleClass="game-info-heading" />
                    <Label fx:id="p1CumulativeWinningsLabel" text="Player 1: $0" styleClass="game-info-value" wrapText="true" />
                    <Label fx:id="p2CumulativeWinningsLabel" text="Player 2: $0" styleClass="game-info-value" wrapText="true" />
                </VBox>
                <Button id="gameMenuButton" layoutX="16" layoutY="118" text="Main Menu"
                        onAction="#handleMainMenu" styleClass="secondary-button" />

                <Button fx:id="motionButton" layoutX="16" layoutY="158" prefWidth="102"
                        text="Motion: On" onAction="#handleToggleMotion" styleClass="secondary-button" />
                <VBox layoutX="714" layoutY="14" prefWidth="270" spacing="6" alignment="CENTER"
                      styleClass="game-info-panel">
                    <Label fx:id="hintTitleLabel" text="Wagering" styleClass="game-info-heading" />
                    <Label fx:id="hintDescriptionLabel" text="Confirm both wagers, then Deal."
                           wrapText="true" prefWidth="244" minHeight="42" styleClass="game-info-copy" />
                    <Button fx:id="hintButton" onAction="#handleHideHints" text="Hide Hints"
                            mnemonicParsing="false" styleClass="secondary-button" />
                </VBox>

                <HBox fx:id="dealerCardBox" alignment="CENTER" layoutX="392.5" layoutY="35"
                      prefHeight="100" prefWidth="215" spacing="5" />

                <Label fx:id="dealerShowdownLabel" layoutX="310" layoutY="140" prefWidth="380"
                       alignment="CENTER" textAlignment="CENTER" wrapText="true" visible="false"
                       styleClass="game-info-heading" />

                <VBox alignment="CENTER" layoutX="330" layoutY="360" prefWidth="340" spacing="4">
                    <Label fx:id="roundStateLabel" wrapText="true" maxWidth="340"
                           textAlignment="CENTER" text="Round" styleClass="game-phase-heading" />
                    <Label fx:id="roundStateSubtitle" wrapText="true" maxWidth="340"
                           textAlignment="CENTER" text="Waiting" styleClass="game-phase-copy" />
                </VBox>

                <Label fx:id="p1DecisionLabel" layoutX="16" layoutY="467" prefWidth="300"
                       text="Player 1" styleClass="game-phase-copy" />
                <Label fx:id="p2DecisionLabel" layoutX="684" layoutY="467" prefWidth="300"
                       alignment="CENTER_RIGHT" text="Player 2" styleClass="game-phase-copy" />
                <VBox layoutX="12" layoutY="491" prefWidth="108" alignment="CENTER_LEFT"
                      spacing="3" styleClass="game-info-panel">
                    <Label fx:id="p1AnteDisplayLabel" text="Ante: $0" styleClass="game-info-copy" />
                    <Label fx:id="p1PairPlusDisplayLabel" text="Pair Plus: $0" styleClass="game-info-copy" />
                </VBox>
                <HBox layoutX="128" layoutY="501" spacing="5">
                    <Button fx:id="p1PlayButton" onAction="#handlePlayer1Play" prefWidth="90"
                            styleClass="gold-button" text="Play" accessibleText="Player 1 Play" disable="true" />
                    <Button fx:id="p1FoldButton" onAction="#handlePlayer1Fold" prefWidth="90"
                            styleClass="secondary-button" text="Fold" accessibleText="Player 1 Fold" disable="true" />
                </HBox>
                <HBox fx:id="player1CardBox" alignment="CENTER" layoutX="24" layoutY="546"
                      prefHeight="100" prefWidth="215" spacing="5" />
                <VBox layoutX="880" layoutY="491" prefWidth="108" alignment="CENTER_LEFT"
                      spacing="3" styleClass="game-info-panel">
                    <Label fx:id="p2AnteDisplayLabel" text="Ante: $0" styleClass="game-info-copy" />
                    <Label fx:id="p2PairPlusDisplayLabel" text="Pair Plus: $0" styleClass="game-info-copy" />
                </VBox>
                <HBox layoutX="687" layoutY="501" spacing="5">
                    <Button fx:id="p2PlayButton" onAction="#handlePlayer2Play" prefWidth="90"
                            styleClass="gold-button" text="Play" accessibleText="Player 2 Play" disable="true" />
                    <Button fx:id="p2FoldButton" onAction="#handlePlayer2Fold" prefWidth="90"
                            styleClass="secondary-button" text="Fold" accessibleText="Player 2 Fold" disable="true" />
                </HBox>
                <HBox fx:id="player2CardBox" alignment="CENTER" layoutX="761" layoutY="546"
                      prefHeight="100" prefWidth="215" spacing="5" />

                <Button fx:id="handHelpButton" id="handHelpButton" layoutX="425" layoutY="480"
                        prefHeight="32" prefWidth="150" text="Hand Help" visible="false" disable="true"
                        onAction="#handleShowHandHelp" styleClass="secondary-button" />

                <Button fx:id="viewResultsButton" layoutX="425" layoutY="450" prefHeight="40"
                        prefWidth="150" onAction="#handleViewResults" styleClass="gold-button"
                        text="View Results" visible="false" disable="true" />

                <VBox layoutX="350" layoutY="518" prefWidth="300" spacing="7" alignment="CENTER">
                    <HBox spacing="12" alignment="CENTER" styleClass="game-info-panel">
                        <VBox alignment="CENTER" spacing="2" prefWidth="128">
                            <Label text="Player 1" styleClass="game-info-heading" />
                            <Label text="Current wager" styleClass="game-info-copy" />
                            <Label fx:id="p1CurrentWagerLabel" text="\$0" styleClass="game-info-value" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="2" prefWidth="128">
                            <Label text="Player 2" styleClass="game-info-heading" />
                            <Label text="Current wager" styleClass="game-info-copy" />
                            <Label fx:id="p2CurrentWagerLabel" text="\$0" styleClass="game-info-value" />
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER" spacing="12" styleClass="game-info-panel">
                        <Label text="Total bets in play:" styleClass="game-info-copy" />
                        <Label fx:id="totalBetsLabel" text="\$0" styleClass="game-info-value" />
                    </HBox>
                </VBox>
            </children>
        </AnchorPane>

        <VBox fx:id="wagerOverlayPane" alignment="CENTER" spacing="11"
              prefWidth="760" maxWidth="760" prefHeight="365" maxHeight="365"
              styleClass="wager-overlay">
            <Label fx:id="wagerPhaseLabel" text="Confirm both wagers" styleClass="wager-heading"
                   wrapText="true" maxWidth="720" textAlignment="CENTER" />
            <HBox alignment="CENTER" spacing="24">
                <VBox alignment="CENTER" spacing="8" prefWidth="342" maxWidth="342"
                      styleClass="wager-panel">
                    <Label text="Player 1's Wagers" styleClass="wager-heading" />
                    <HBox alignment="CENTER" spacing="16">
                        <VBox spacing="5" prefWidth="135">
                            <Label text="Ante ($5–$25)" styleClass="wager-field-label" />
                            <TextField fx:id="p1AnteField" accessibleText="Player 1 Ante, 5 to 25 dollars"
                                       promptText="e.g. 10" prefWidth="135" styleClass="wager-input" />
                        </VBox>
                        <VBox spacing="5" prefWidth="135">
                            <Label text="Pair Plus (optional)" styleClass="wager-field-label" />
                            <TextField fx:id="p1PairPlusField" accessibleText="Player 1 Pair Plus, optional"
                                       promptText="0 or 5–25" prefWidth="135" styleClass="wager-input" />
                        </VBox>
                    </HBox>
                    <Label text="Pair Plus: blank, $0, or $5–$25" styleClass="game-info-copy" />
                    <Button fx:id="p1ConfirmButton" text="Confirm" accessibleText="Confirm Player 1 wagers"
                            onAction="#handleP1ConfirmWager" styleClass="gold-button" prefWidth="126" />
                    <Label fx:id="p1WagerStatusLabel" text="Enter your wagers, then Confirm."
                           alignment="CENTER" textAlignment="CENTER" wrapText="true" minHeight="48"
                           prefWidth="306" styleClass="wager-feedback" />
                </VBox>
                <VBox alignment="CENTER" spacing="8" prefWidth="342" maxWidth="342"
                      styleClass="wager-panel">
                    <Label text="Player 2's Wagers" styleClass="wager-heading" />
                    <HBox alignment="CENTER" spacing="16">
                        <VBox spacing="5" prefWidth="135">
                            <Label text="Ante ($5–$25)" styleClass="wager-field-label" />
                            <TextField fx:id="p2AnteField" accessibleText="Player 2 Ante, 5 to 25 dollars"
                                       promptText="e.g. 10" prefWidth="135" styleClass="wager-input" />
                        </VBox>
                        <VBox spacing="5" prefWidth="135">
                            <Label text="Pair Plus (optional)" styleClass="wager-field-label" />
                            <TextField fx:id="p2PairPlusField" accessibleText="Player 2 Pair Plus, optional"
                                       promptText="0 or 5–25" prefWidth="135" styleClass="wager-input" />
                        </VBox>
                    </HBox>
                    <Label text="Pair Plus: blank, $0, or $5–$25" styleClass="game-info-copy" />
                    <Button fx:id="p2ConfirmButton" text="Confirm" accessibleText="Confirm Player 2 wagers"
                            onAction="#handleP2ConfirmWager" styleClass="gold-button" prefWidth="126" />
                    <Label fx:id="p2WagerStatusLabel" text="Enter your wagers, then Confirm."
                           alignment="CENTER" textAlignment="CENTER" wrapText="true" minHeight="48"
                           prefWidth="306" styleClass="wager-feedback" />
                </VBox>
            </HBox>
            <Button fx:id="startDealButton" text="Deal" onAction="#handleStartDealAfterWagers"
                    prefHeight="40" prefWidth="155" disable="true" styleClass="gold-button" />
            <Label text="Only confirmed wagers are saved when returning to the menu."
                   styleClass="game-info-copy" />
        </VBox>

        <VBox fx:id="handHelpPane" visible="false" managed="false"
              prefWidth="650" maxWidth="650" maxHeight="470" alignment="CENTER"
              spacing="10" styleClass="hand-help-panel">
            <Label text="Hand Help" styleClass="screen-title" />
            <Label text="Strongest to weakest • Example cards only • Pair Plus profit"
                   styleClass="rules-copy" wrapText="true" textAlignment="CENTER" />
            <VBox spacing="5" alignment="CENTER_LEFT" styleClass="rules-panel">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="Straight Flush" prefWidth="145" styleClass="rules-rank" />
                    <Label text="7♥  8♥  9♥" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="Consecutive ranks, same suit." prefWidth="210" styleClass="rules-copy" />
                    <Label text="40:1" prefWidth="82" styleClass="rules-rank" />
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="Three of a Kind" prefWidth="145" styleClass="rules-rank" />
                    <Label text="K♣  K♥  K♠" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="Three matching ranks." prefWidth="210" styleClass="rules-copy" />
                    <Label text="30:1" prefWidth="82" styleClass="rules-rank" />
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="Straight" prefWidth="145" styleClass="rules-rank" />
                    <Label text="5♣  6♥  7♠" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="Three consecutive ranks." prefWidth="210" styleClass="rules-copy" />
                    <Label text="6:1" prefWidth="82" styleClass="rules-rank" />
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="Flush" prefWidth="145" styleClass="rules-rank" />
                    <Label text="2♦  8♦  Q♦" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="Three cards of one suit." prefWidth="210" styleClass="rules-copy" />
                    <Label text="3:1" prefWidth="82" styleClass="rules-rank" />
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="Pair" prefWidth="145" styleClass="rules-rank" />
                    <Label text="J♣  J♥  4♠" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="Two matching ranks." prefWidth="210" styleClass="rules-copy" />
                    <Label text="1:1" prefWidth="82" styleClass="rules-rank" />
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="hand-help-row">
                    <Label text="High Card" prefWidth="145" styleClass="rules-rank" />
                    <Label text="3♣  8♥  A♠" prefWidth="112" styleClass="hand-help-example" />
                    <Label text="No higher classification." prefWidth="210" styleClass="rules-copy" />
                    <Label text="No payout" prefWidth="82" styleClass="rules-rank" />
                </HBox>
            </VBox>
            <Label text="Current rules: Ace = 14; A–2–3 is not a straight. Pair Plus is forfeited when you fold."
                   wrapText="true" maxWidth="600" textAlignment="CENTER" styleClass="rules-copy" />
            <Button fx:id="closeHandHelpButton" id="closeHandHelpButton" text="Close Hand Help"
                    onAction="#handleCloseHandHelp" prefWidth="170" minHeight="36"
                    styleClass="secondary-button" />
        </VBox>
    </children>
</StackPane>
